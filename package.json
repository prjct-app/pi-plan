{
  "name": "@prjct.app/pi-plan",
  "version": "0.1.3",
  "description": "Read-only planning with an approval step and tracked execution in Pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "plan",
    "planning",
    "workflow",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-plan.git"
  },
  "homepage": "https://github.com/prjct-app/pi-plan#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-plan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/package.md"
  ]
}
