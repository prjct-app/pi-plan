{
  "name": "@prjct.app/pi-plan",
  "version": "0.3.4",
  "description": "Plan before editing in PI Agent with read-only tool restrictions, an approval step, and task progress tracking.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "planning",
    "plan-mode",
    "task-management",
    "human-in-the-loop"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-plan/main/docs/cover.png"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-plan.git"
  },
  "homepage": "https://github.com/prjct-app/pi-plan#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-plan/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/package.md",
    "docs/cover.png",
    "docs/releases.md"
  ],
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.1"
  }
}
